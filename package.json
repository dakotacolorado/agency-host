{
  "name": "agent-host",
  "version": "0.2.0",
  "private": true,
  "description": "Makes a machine one of agent-service's hosts: runs agents' Claude Code sessions on the Claude Agent SDK and reports them over one socket.",
  "type": "module",
  "bin": {
    "agent-host": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "smol-toml": "^1.9.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
