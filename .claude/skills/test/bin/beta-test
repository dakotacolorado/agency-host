#!/usr/bin/env bash
# The beta test: this commit's binary run as a host of its own against the
# agent-service named by AGENT_SERVICE_URL and AGENT_SERVICE_TOKEN
# (tests/agent_service.rs). Never prod. The token is never printed. Prints
# `deployed: <commit>` once it passes.
set -euo pipefail
cd "$(dirname "$0")/../../../.."

url=${AGENT_SERVICE_URL:-}
# Without both the test says `skipped:` and passes, which proves nothing.
case $url in http://* | https://*) ;; *) echo "beta-test: AGENT_SERVICE_URL is not an http(s) url ($url)" >&2; exit 1 ;; esac
[ -n "${AGENT_SERVICE_TOKEN:-}" ] || { echo "beta-test: AGENT_SERVICE_TOKEN is empty" >&2; exit 1; }
echo "agent-service: $url"

log=$(mktemp)
cargo test --locked --test agent_service -- --nocapture 2>&1 | tee "$log"
if grep -q 'skipped:' "$log" || ! grep -q 'test result: ok. 1 passed' "$log"; then
  echo "beta-test: the test did not run and pass against $url" >&2
  exit 1
fi
echo "deployed: $(git rev-parse HEAD) ran as a host against $url for the test; no host stays"
