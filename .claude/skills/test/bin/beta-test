#!/usr/bin/env bash
# The beta test: this commit's binary run as a host of its own against
# WorkerService-beta (tests/worker_service.rs). Never prod. Needs AWS credentials;
# the token is never printed. Prints `deployed: <commit>` once it passes.
set -euo pipefail
cd "$(dirname "$0")/../../../.."

url=$(aws cloudformation describe-stacks --stack-name WorkerService-beta \
  --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text)
token=$(aws secretsmanager get-secret-value --secret-id worker-service/beta/token --query SecretString --output text)
# Without both the test says `skipped:` and passes, which proves nothing.
case $url in https://*) ;; *) echo "beta-test: WorkerService-beta has no ApiUrl ($url)" >&2; exit 1 ;; esac
[ -n "$token" ] || { echo "beta-test: worker-service/beta/token is empty" >&2; exit 1; }
echo "worker-service beta: $url"

log=$(mktemp)
WORKER_SERVICE_URL=$url WORKER_SERVICE_TOKEN=$token \
  cargo test --locked --test worker_service -- --nocapture 2>&1 | tee "$log"
if grep -q 'skipped:' "$log" || ! grep -q 'test result: ok. 1 passed' "$log"; then
  echo "beta-test: the test did not run and pass against beta" >&2
  exit 1
fi
echo "deployed: $(git rev-parse HEAD) ran as a host against WorkerService-beta for the test; no host stays"
