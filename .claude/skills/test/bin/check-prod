#!/usr/bin/env bash
# Read-only check of prod, the GitHub release marked Latest, which is what
# scripts/install-host.sh installs: it has the four binaries and SHA256SUMS,
# each matches, each is built for its target, and the linux one runs and says
# the release's tag. Needs gh signed in (GH_TOKEN). Prints the Latest
# release's commit and tag; it may be another commit than the one checked out.
set -euo pipefail

repo=dakotacolorado/worker-host
targets=(x86_64-unknown-linux-musl aarch64-unknown-linux-musl aarch64-apple-darwin x86_64-apple-darwin)

read -r tag commit assets < <(gh release view --repo "$repo" --json tagName,targetCommitish,assets --jq '"\(.tagName) \(.targetCommitish) \(.assets | length)"')
echo "latest: $tag at $commit, $assets assets"
[ "$assets" = 5 ] || { echo "FAIL $tag has $assets assets, not 5" >&2; exit 1; }

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
gh release download "$tag" --repo "$repo" --dir "$dir"
(cd "$dir" && sha256sum --check SHA256SUMS)
for t in "${targets[@]}"; do
  [ -f "$dir/worker-host-$t" ] || { echo "FAIL $tag has no worker-host-$t" >&2; exit 1; }
  echo "worker-host-$t: $(file -b "$dir/worker-host-$t")"
done

bin=$dir/worker-host-x86_64-unknown-linux-musl
chmod +x "$bin"
said=$("$bin" --version)
echo "--version: $said"
# Releases up to v0.1.0-47 were built before the build was given its tag.
n=${tag##*-}
[ "$said" = "worker-host $tag" ] || { [ "$said" = "worker-host 0.1.0" ] && [ "$n" -le 47 ] 2>/dev/null; } ||
  { echo "FAIL the binary says '$said', not 'worker-host $tag'" >&2; exit 1; }
echo "deployed: $commit $tag"
echo "PASS prod"
