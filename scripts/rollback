#!/usr/bin/env bash
# Rolls prod back to the release built from the commit checked out: makes the
# newest release at this commit Latest again, and marks each release numbered
# after it a prerelease, so scripts/install-host.sh takes this one. A host that
# installed a newer one keeps it until its owner runs install-host.sh again.
# Prints `deployed: <commit> <tag>`.
#
#   scripts/rollback            reviewer or approval-service only (needs GH_TOKEN)
#   DRY_RUN=1 scripts/rollback  says what it would change, changing nothing
set -euo pipefail
cd "$(dirname "$0")/.."

repo=dakotacolorado/worker-host
dry=${DRY_RUN:-}
commit=$(git rev-parse HEAD)
echo "commit: $commit"

# <number> <tag> <commit> <prerelease>, one per release, highest number first.
releases=$(gh api --paginate "repos/$repo/releases" \
  --jq '.[] | select(.draft | not) | "\(.tag_name) \(.target_commitish) \(.prerelease)"' |
  sed -n 's/^\(v[^ ]*-\([0-9][0-9]*\)\) /\2 \1 /p' | sort -rn)

read -r good_n good _ good_pre < <(awk -v c="$commit" '$3 == c' <<<"$releases" | head -1) || true
[ -n "${good:-}" ] || { echo "rollback: no release was built from $commit" >&2; exit 1; }
echo "returning to: $good"

run() { if [ -n "$dry" ]; then echo "dry run: would run: $*"; else echo "running: $*"; "$@"; fi; }

if [ "$good_pre" = true ]; then
  run gh release edit "$good" --repo "$repo" --prerelease=false --latest
else
  run gh release edit "$good" --repo "$repo" --latest
fi
while read -r n tag _ pre; do
  [ "$n" -gt "$good_n" ] && [ "$pre" = false ] || continue
  run gh release edit "$tag" --repo "$repo" --prerelease
done <<<"$releases"

[ -n "$dry" ] && exit 0
read -r got_tag got_commit < <(gh release view --repo "$repo" --json tagName,targetCommitish --jq '"\(.tagName) \(.targetCommitish)"')
if [ "$got_tag" != "$good" ] || [ "$got_commit" != "$commit" ]; then
  echo "rollback: Latest is $got_tag at $got_commit, not $good at $commit" >&2
  exit 1
fi
echo "deployed: $commit $good"
