#!/usr/bin/env bash
# Releases the commit checked out: builds the four binaries with zig, checks
# them, and publishes them as the next GitHub release, which becomes Latest and
# so is what scripts/install-host.sh installs. Prints `deployed: <commit> <tag>`.
#
#   scripts/release            reviewer or approval-service only (needs GH_TOKEN)
#   DRY_RUN=1 scripts/release  all but publishing; without gh signed in, the tag is a stand-in
#
# A commit already Latest is not released again, so a retried job prints it and stops.
set -euo pipefail
cd "$(dirname "$0")/.."

repo=dakotacolorado/worker-host
targets=(x86_64-unknown-linux-musl aarch64-unknown-linux-musl aarch64-apple-darwin x86_64-apple-darwin)
dry=${DRY_RUN:-}

if [ -n "$(git status --porcelain)" ]; then
  echo "release: the tree is not clean, so the binaries would not be the commit's:" >&2
  git status --short >&2
  exit 1
fi
commit=$(git rev-parse HEAD)
version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
echo "commit: $commit"

if gh auth status >/dev/null 2>&1; then
  read -r latest_tag latest_commit < <(gh release view --repo "$repo" --json tagName,targetCommitish --jq '"\(.tagName) \(.targetCommitish)"' || echo "- -")
  if [ "$latest_commit" = "$commit" ]; then
    echo "release: $latest_tag is already Latest at $commit"
    [ -n "$dry" ] && { echo "dry run: nothing to publish"; exit 0; }
    echo "deployed: $commit $latest_tag"
    exit 0
  fi
  # Numbered one past the highest release, whatever its version or whether it is a prerelease.
  last=$(gh api --paginate "repos/$repo/releases" --jq '.[].tag_name' | sed -n 's/^v.*-\([0-9][0-9]*\)$/\1/p' | sort -n | tail -1)
  tag="v$version-$((${last:-0} + 1))"
elif [ -n "$dry" ]; then
  tag="v$version-dry-run"
else
  echo "release: gh is not signed in (GH_TOKEN), so nothing can be published" >&2
  exit 1
fi
echo "tag: $tag"

for t in "${targets[@]}"; do
  echo "building $t"
  WORKER_HOST_RELEASE="$tag" cargo zigbuild --release --locked --target "$t"
done
# zig leaves this in the working directory.
rm -f .intentionally-empty-file.o

want() { # want <target> <what file(1) must say>
  local said
  said=$(file -b "target/$1/release/worker-host")
  echo "$1: $said"
  grep -Eq "$2" <<<"$said" || { echo "release: $1 is not $2" >&2; exit 1; }
}
want x86_64-unknown-linux-musl 'ELF 64-bit.*x86-64.*(statically linked|static-pie linked)'
want aarch64-unknown-linux-musl 'ELF 64-bit.*(ARM aarch64|aarch64).*(statically linked|static-pie linked)'
want aarch64-apple-darwin 'Mach-O 64-bit.*arm64'
want x86_64-apple-darwin 'Mach-O 64-bit.*x86_64'
said=$(target/x86_64-unknown-linux-musl/release/worker-host --version)
echo "--version: $said"
[ "$said" = "worker-host $tag" ] || { echo "release: the binary says '$said', not 'worker-host $tag'" >&2; exit 1; }

rm -rf target/dist && mkdir target/dist
for t in "${targets[@]}"; do cp "target/$t/release/worker-host" "target/dist/worker-host-$t"; done
chmod +x target/dist/*
(cd target/dist && sha256sum worker-host-* > SHA256SUMS && cat SHA256SUMS)
[ -z "$(git status --porcelain)" ] || { echo "release: the build changed the tree:" >&2; git status --short >&2; exit 1; }

notes="Built from $commit by scripts/release: WORKER_HOST_RELEASE=$tag cargo zigbuild --release --locked for each target. Install with scripts/install-host.sh; see the README."
if [ -n "$dry" ]; then
  echo "dry run: would publish $tag at $commit with: gh release create $tag target/dist/* --repo $repo --target $commit --latest"
  exit 0
fi

gh release create "$tag" target/dist/* --repo "$repo" --target "$commit" --latest --title "worker-host $tag" --notes "$notes"

read -r got_tag got_commit assets < <(gh release view --repo "$repo" --json tagName,targetCommitish,assets --jq '"\(.tagName) \(.targetCommitish) \(.assets | length)"')
if [ "$got_tag" != "$tag" ] || [ "$got_commit" != "$commit" ] || [ "$assets" != 5 ]; then
  echo "release: Latest is $got_tag at $got_commit with $assets assets, not $tag at $commit with 5" >&2
  exit 1
fi
echo "deployed: $commit $tag"
